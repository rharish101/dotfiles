{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "lastChangelogVersion": "1.4.0",
  "theme": "selenized-black",
  "packages": [
    "npm:pi-vimmode",
    "npm:@juicesharp/rpiv-todo",
    "npm:@narumitw/pi-btw",
    "npm:@robhowley/pi-spinner-verbs",
    "npm:@narumitw/pi-lsp",
    "npm:@99percentpeople/pi-background-tasks",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@gotgenes/pi-subagents",
    "npm:pi-minimalist"
  ],
  "defaultProvider": "llama.cpp",
  "defaultModel": "Qwen-3.8-27B",
  "spinnerVerbsFile": "verbs.json",
  "enableInstallTelemetry": false,
  "quietStartup": true,
  "collapseChangelog": true,
  "defaultTools": [
    "+codemode"
  ],
  "tuiMode": "regular",
  "terminal": {
    "showTerminalProgress": true
  },
  "minimalist": {
    "preset": "full",
    "gutter": false,
    "keepActiveThinkingExpanded": true
  },
  "hideThinkingBlock": true
}